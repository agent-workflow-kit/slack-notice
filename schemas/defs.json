{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slack-notice/defs.json",
  "title": "slack-notice shared definitions",
  "description": "Not an output on its own. Shared definitions referenced by the notification, CLI and log schemas. config.json embeds its own copies.",
  "$defs": {
    "level": {
      "enum": [
        "info",
        "warn",
        "action",
        "error"
      ],
      "description": "Ordered info < warn < action < error; the order matters to callers, not to slack-notice."
    },
    "duration": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "string",
          "pattern": "^(?=.*[1-9])[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h|d)$"
        },
        {
          "type": "string",
          "pattern": "^(?=.*[1-9])[0-9]+(?:\\.[0-9]+)?$"
        }
      ],
      "description": "Seconds as a positive number, a string <number><unit> with unit ms, s, m, h or d (e.g. '1s'), or a bare number string meaning seconds; zero is refused. Ranges are enforced by the loader and named in the key's description."
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$",
      "description": "RFC 3339."
    },
    "sha256_16": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "First 16 hex characters of a SHA-256."
    },
    "actor": {
      "type": "string",
      "pattern": "^(human|auto):[A-Za-z0-9._@-]{1,64}$",
      "description": "human:<user> or auto:<name>. Advisory against same-user processes."
    },
    "dedupe_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:@/-]{1,128}$",
      "description": "A caller's --dedupe-key. Accepted for uniformity; Slack has no deduplication."
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2,
        12,
        20,
        22
      ]
    },
    "error_code": {
      "enum": [
        "usage",
        "config_invalid",
        "internal",
        "refused",
        "host_rejected",
        "auth_required",
        "rate_limited",
        "upstream_error",
        "network_error",
        "outcome_unknown",
        "wrong_host_response",
        "unavailable",
        "state_unsafe"
      ],
      "description": "refused is exit 20; usage and config_invalid exit 2; the rest of the list except internal exit 12."
    },
    "refusal_reason": {
      "enum": [
        "invalid_payload",
        "empty_message",
        "link_invalid",
        "link_scheme",
        "credential_missing"
      ],
      "description": "On exit 20 (code refused)."
    },
    "error_details": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "config_invalid: the offending config key."
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/[^/]*)*$",
          "description": "invalid_payload: RFC 6901 JSON pointer into the input."
        },
        "env": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "credential_missing: the name (never the value) of the variable."
        },
        "host_error": {
          "type": [
            "string",
            "null"
          ],
          "x-untrusted": true,
          "pattern": "^[A-Za-z0-9_.-]{1,64}$",
          "description": "host_rejected: the response's short error token, else null. Untrusted: from the server."
        },
        "http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "lock": {
          "type": "string",
          "description": "unavailable: which lock was busy."
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/error_code"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "description": "Never contains the webhook URL or any part of it."
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "On exit 20 (code refused) a refusal_reason; on unavailable the value locked; null otherwise."
        },
        "details": {
          "$ref": "#/$defs/error_details"
        },
        "retryable": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "A boolean on exit 12 (see the table in the Error envelope section of the interface), null elsewhere."
        },
        "retry_after_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Exit 12 rate_limited: the last wait, else null."
        },
        "unknown_outcome": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Set on exit 12, null elsewhere. True when the message may have been sent."
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "refused"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "$ref": "#/$defs/refusal_reason"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "unavailable"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "const": "locked"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "refused",
                  "unavailable"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "else": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "host_rejected",
                  "auth_required",
                  "rate_limited",
                  "upstream_error",
                  "network_error",
                  "outcome_unknown",
                  "wrong_host_response",
                  "unavailable",
                  "state_unsafe"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "retryable",
              "retry_after_s",
              "unknown_outcome"
            ],
            "properties": {
              "retryable": {
                "type": "boolean"
              },
              "retry_after_s": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "unknown_outcome": {
                "type": "boolean"
              }
            }
          },
          "else": {
            "properties": {
              "retryable": {
                "type": "null"
              },
              "retry_after_s": {
                "type": "null"
              },
              "unknown_outcome": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "host_rejected",
                  "auth_required",
                  "wrong_host_response",
                  "state_unsafe"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "retryable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "rate_limited",
                  "upstream_error",
                  "network_error",
                  "unavailable",
                  "outcome_unknown"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "retryable": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "outcome_unknown"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "unknown_outcome": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "host_rejected",
                  "auth_required",
                  "state_unsafe",
                  "rate_limited",
                  "upstream_error",
                  "network_error",
                  "unavailable"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "unknown_outcome": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "config_invalid"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "key"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "invalid_payload"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "pointer"
                ],
                "properties": {
                  "pointer": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "credential_missing"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "env"
                ],
                "properties": {
                  "env": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "host_rejected"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "host_error",
                  "http_status"
                ],
                "properties": {
                  "host_error": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "http_status": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "unavailable"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "required": [
              "details"
            ],
            "properties": {
              "details": {
                "type": "object",
                "required": [
                  "lock"
                ],
                "properties": {
                  "lock": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
