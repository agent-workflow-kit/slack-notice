{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slack-notice/log.json",
  "title": "slack-notice log.jsonl record",
  "description": "One record per send that reaches the POST step and per refusal or failure after input validation. Never contains a title, message, link, URL or credential. A log write failure warns only. Rotates at 1 MiB, keeping 3 files.",
  "type": "object",
  "properties": {
    "ts": {
      "$ref": "defs.json#/$defs/ts"
    },
    "tool": {
      "const": "slack-notice"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "sent",
        "refused",
        "failed",
        "disabled"
      ]
    },
    "exit": {
      "$ref": "defs.json#/$defs/exit_code"
    },
    "code": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/error_code"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "level": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/level"
        },
        {
          "type": "null"
        }
      ]
    },
    "bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "truncated": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "http_status": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 599
    },
    "message_sha256": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/sha256_16"
        },
        {
          "type": "null"
        }
      ],
      "description": "Of the rendered body; null when nothing was rendered."
    },
    "dedupe_key_sha256": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/sha256_16"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor": {
      "$ref": "defs.json#/$defs/actor"
    },
    "actor_source": {
      "type": "string",
      "pattern": "^[a-z_]{1,32}$",
      "description": "How the actor was determined (flag, tty or default)."
    }
  },
  "required": [
    "ts",
    "tool",
    "version",
    "outcome",
    "exit",
    "code",
    "reason",
    "level",
    "bytes",
    "truncated",
    "duration_ms",
    "http_status",
    "message_sha256",
    "dedupe_key_sha256",
    "actor",
    "actor_source"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "sent"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "exit": {
            "const": 0
          },
          "code": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "disabled"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "exit": {
            "const": 22
          }
        }
      }
    }
  ]
}
