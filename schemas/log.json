{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slack-notice/log.json",
  "title": "slack-notice log.jsonl record",
  "description": "One record per outcome that reaches send step 3 or later (sent, refused, failed, outcome_unknown). Not logged: exit 1, exit 2, exit 22 and dry runs. Never contains a title, message, link, URL or credential. A log write failure warns only. Rotates at 1 MiB, keeping 3 files. A state-directory problem writes no record and never changes the exit code.",
  "type": "object",
  "properties": {
    "ts": {
      "$ref": "defs.json#/$defs/ts"
    },
    "tool": {
      "const": "slack-notice"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "sent",
        "refused",
        "failed",
        "outcome_unknown"
      ]
    },
    "exit": {
      "enum": [
        0,
        12,
        20
      ]
    },
    "code": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/error_code"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/refusal_reason"
        },
        {
          "type": "null"
        }
      ],
      "description": "A refusal reason on refused, else null."
    },
    "level": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/level"
        },
        {
          "type": "null"
        }
      ]
    },
    "bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "truncated": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "http_status": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 599
    },
    "message_sha256": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/sha256_16"
        },
        {
          "type": "null"
        }
      ],
      "description": "First 16 hex of the SHA-256 of the sanitized title, LF and sanitized message; null when not computed."
    },
    "dedupe_key_sha256": {
      "oneOf": [
        {
          "$ref": "defs.json#/$defs/sha256_16"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor": {
      "$ref": "defs.json#/$defs/actor"
    },
    "actor_source": {
      "enum": [
        "flag",
        "tty",
        "default"
      ],
      "description": "flag: from --actor; tty: stdin is a terminal; default: auto:unknown."
    }
  },
  "required": [
    "ts",
    "tool",
    "version",
    "outcome",
    "exit",
    "code",
    "reason",
    "level",
    "bytes",
    "truncated",
    "duration_ms",
    "http_status",
    "message_sha256",
    "dedupe_key_sha256",
    "actor",
    "actor_source"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "sent"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "exit": {
            "const": 0
          },
          "code": {
            "type": "null"
          },
          "reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "refused"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "exit": {
            "const": 20
          },
          "code": {
            "const": "refused"
          },
          "reason": {
            "$ref": "defs.json#/$defs/refusal_reason"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "failed"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "exit": {
            "const": 12
          },
          "code": {
            "enum": [
              "host_rejected",
              "auth_required",
              "credential_invalid",
              "rate_limited",
              "network_error",
              "unavailable",
              "wrong_host_response"
            ]
          },
          "reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "outcome_unknown"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "exit": {
            "const": 12
          },
          "code": {
            "enum": [
              "outcome_unknown",
              "upstream_error",
              "wrong_host_response"
            ]
          },
          "reason": {
            "type": "null"
          }
        }
      }
    }
  ]
}
