{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slack-notice/cli/validate.json",
  "title": "validate --json output",
  "description": "Printed by validate when the config loads (an unloadable config prints the error envelope and exits 2). ok false is printed with the exit code of the first failing check (20 refused, 2 config_invalid, 12). With --probe the document has probe {sent, delivery_not_observable}: Slack accepts a request with a wrong variable name and drops it, so a human must look in Slack.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "description": "Never contains the webhook URL or any part of it."
          }
        },
        "required": [
          "name",
          "ok",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "probe": {
      "type": "object",
      "description": "--probe only.",
      "properties": {
        "sent": {
          "type": "boolean",
          "description": "True when Slack accepted the test message."
        },
        "delivery_not_observable": {
          "const": true,
          "description": "Always true: a human must look in Slack."
        }
      },
      "required": [
        "sent",
        "delivery_not_observable"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "ok",
    "checks"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "ok": {
                  "const": true
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "probe": {
            "properties": {
              "sent": {
                "const": false
              }
            },
            "required": [
              "sent"
            ]
          }
        },
        "required": [
          "probe"
        ]
      },
      "then": {
        "properties": {
          "ok": {
            "const": false
          }
        }
      }
    }
  ]
}
