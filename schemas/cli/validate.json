{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slack-notice/cli/validate.json",
  "title": "validate --json output",
  "description": "Printed by validate when the config loads (an unloadable config prints the error envelope and exits 2). validate never prompts. Checks run in order (config, credential, test_message) and a failed check ends the run, so ok is true only when every printed check is ok. ok false is printed with the exit code of the failing check. With --test-message on a disabled tool nothing is sent and the document is {outcome: disabled} (exit 22). Delivery of a test message is not observable: a human must look in Slack.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean",
          "description": "The configured value."
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "enum": [
                  "config",
                  "credential",
                  "test_message"
                ]
              },
              "ok": {
                "type": "boolean"
              },
              "message": {
                "type": "string",
                "description": "Never contains the webhook URL or any part of it."
              }
            },
            "required": [
              "name",
              "ok",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ok",
        "enabled",
        "checks"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "ok": {
                "const": true
              }
            },
            "required": [
              "ok"
            ]
          },
          "then": {
            "properties": {
              "checks": {
                "items": {
                  "properties": {
                    "ok": {
                      "const": true
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ok": {
                "const": false
              }
            },
            "required": [
              "ok"
            ]
          },
          "then": {
            "properties": {
              "checks": {
                "contains": {
                  "properties": {
                    "ok": {
                      "const": false
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "disabled"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  ]
}
