{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slack-notice/cli/validate.json",
  "title": "validate --json output",
  "description": "Printed by validate. With --probe a successful test message adds outcome sent and delivery_not_observable: Slack accepts a request with a wrong variable name and drops it, so a human must look in Slack.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "description": "Never contains the webhook URL or any part of it."
          }
        },
        "required": [
          "name",
          "ok",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "outcome": {
      "const": "sent",
      "description": "--probe only, on success."
    },
    "delivery_not_observable": {
      "const": true,
      "description": "--probe only, on success."
    }
  },
  "required": [
    "ok",
    "checks"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "ok": {
                  "const": true
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "sent"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "delivery_not_observable",
          "ok"
        ],
        "properties": {
          "ok": {
            "const": true
          }
        }
      }
    }
  ]
}
