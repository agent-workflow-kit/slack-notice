{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slack-notice/cli/validate.json",
  "title": "validate --json output",
  "description": "Printed by validate when the config loads (an unloadable config prints the error envelope and exits 2). validate never prompts. Checks run in order (config, credential, test_message) and a failed check ends the run, so ok is true only when every printed check is ok. limits is present in every document that has checks and is absent from the error envelope and from {outcome: disabled}. ok false is printed with the exit code of the failing check. Plain validate of a disabled tool runs its checks and reports enabled false. With --test-message on a disabled tool nothing is sent, no check runs and the document is {outcome: disabled} (exit 22), as in send.json. Delivery of a test message is not observable: a human must look in Slack. The checks array is a prefix of config, credential, test_message (never empty, each at most once, in that order) and only its last check may be ok false.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean",
          "description": "The configured value."
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/check",
              "properties": {
                "name": {
                  "const": "config"
                }
              }
            },
            {
              "$ref": "#/$defs/check",
              "properties": {
                "name": {
                  "const": "credential"
                }
              }
            },
            {
              "$ref": "#/$defs/check",
              "properties": {
                "name": {
                  "const": "test_message"
                }
              }
            }
          ],
          "items": false,
          "allOf": [
            {
              "if": {
                "minItems": 2
              },
              "then": {
                "prefixItems": [
                  {
                    "properties": {
                      "ok": {
                        "const": true
                      }
                    }
                  }
                ]
              }
            },
            {
              "if": {
                "minItems": 3
              },
              "then": {
                "prefixItems": [
                  {},
                  {
                    "properties": {
                      "ok": {
                        "const": true
                      }
                    }
                  }
                ]
              }
            }
          ]
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      },
      "required": [
        "ok",
        "enabled",
        "checks",
        "limits"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "ok": {
                "const": true
              }
            },
            "required": [
              "ok"
            ]
          },
          "then": {
            "properties": {
              "checks": {
                "items": {
                  "properties": {
                    "ok": {
                      "const": true
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ok": {
                "const": false
              }
            },
            "required": [
              "ok"
            ]
          },
          "then": {
            "properties": {
              "checks": {
                "contains": {
                  "properties": {
                    "ok": {
                      "const": false
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "const": "disabled"
        }
      },
      "required": [
        "outcome"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "limits": {
      "type": "object",
      "description": "The effective limits of a send: the loaded config over the defaults. Present in every document that has checks, whatever the checks say.",
      "properties": {
        "max_chars": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 12000,
          "description": "The max_chars setting: the body limit in code points."
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "description": "The cap on the request body in bytes; fixed at 12000 (not a setting)."
        },
        "timeout_s": {
          "type": "number",
          "minimum": 3,
          "maximum": 120,
          "description": "The timeout setting in seconds."
        },
        "spacing_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "The spacing between sends in seconds; fixed at 1 (not a setting)."
        }
      },
      "required": [
        "max_chars",
        "max_bytes",
        "timeout_s",
        "spacing_s"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "config",
            "credential",
            "test_message"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "description": "Never contains the webhook URL or any part of it."
        }
      },
      "required": [
        "name",
        "ok",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
